# GHCR 镜像地址（默认 owner: wtfllix）
API_IMAGE=ghcr.io/wtfllix/apikey-vault-api:master-latest
WEB_IMAGE=ghcr.io/wtfllix/apikey-vault-web:master-latest
WEB_PORT=8080

# PostgreSQL
POSTGRES_DB=akv
POSTGRES_USER=akv
POSTGRES_PASSWORD=change_me_strong_password

# 业务配置
DATABASE_URL=postgres://akv:change_me_strong_password@db:5432/akv
JWT_SECRET=change_me_jwt_secret
APP_MASTER_KEY=change_me_master_key_32bytes_or_base64
JWT_EXPIRES_IN=7d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
