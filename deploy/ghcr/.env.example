# New installations: run `node scripts/init-config.mjs` to generate .env.
# Existing installations: read docs/DEPLOYMENT.md; NEVER overwrite the old key.
APP_ORIGIN=https://vault.example.com
POSTGRES_DB=akv
POSTGRES_USER=akv
POSTGRES_PASSWORD=
DATABASE_URL=
APP_MASTER_KEY=
# Only for explicit migration of an old non-base64 key. Keep the exact OLD value.
APP_LEGACY_MASTER_KEY=
# Previous strong keys as a JSON array; used only for decryption.
APP_PREVIOUS_KEYS=[]
BOOTSTRAP_TOKEN=
WEB_PORT=8080
STORAGE_QUOTA_BYTES=10737418240
MAX_FILE_SIZE=10485760
DISK_RESERVE_BYTES=268435456
SESSION_SECONDS=604800
SESSION_IDLE_SECONDS=604800

API_IMAGE=
WEB_IMAGE=
