FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile --prod

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production STORAGE_ROOT=/srv/vault
RUN addgroup -g 101 vaultfiles && addgroup node vaultfiles && mkdir -p /srv/vault/objects /srv/vault/tmp && chown -R node:vaultfiles /srv/vault && chmod 2750 /srv/vault /srv/vault/objects && chmod 700 /srv/vault/tmp
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json ./
COPY server ./server
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:8787/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server/src/index.js"]
