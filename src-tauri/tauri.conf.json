{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "API Key Vault",
  "version": "1.0.0",
  "identifier": "com.apikeyvault.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "API Key 保险箱",
        "width": 560,
        "height": 720,
        "minWidth": 520,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ]
  }
}
